[config]
PROCESS_LIST = EnsembleStat

LOOP_BY = INIT
INIT_TIME_FMT = %Y%m%d%H
INIT_BEG = {ENV[INITDATE]}
INIT_END = {ENV[INITDATE]}

LEAD_SEQ = 0m, 1m, 2m, 3m, 4m, 5m, 6m, 7m, 8m, 9m, 10m, 11m

ENSEMBLE_STAT_N_ENS = 31
ENSEMBLE_STAT_ENS_THRESH = 1.0

ENSEMBLE_STAT_OUTPUT_FLAG_ECNT = NONE
ENSEMBLE_STAT_OUTPUT_FLAG_RPS = NONE

# ------------------------------------------------------------------------------
# Field Definitions (Matching wgrib2 records)
# ------------------------------------------------------------------------------
# 2m Min/Max Temperatures
FCST_ENSEMBLE_STAT_VAR1_NAME = TMAX
FCST_ENSEMBLE_STAT_VAR1_LEVELS = Z2

FCST_ENSEMBLE_STAT_VAR2_NAME = TMIN
FCST_ENSEMBLE_STAT_VAR2_LEVELS = Z2

# Precipitation & Hydrology (Surface)
FCST_ENSEMBLE_STAT_VAR3_NAME = PRATE
FCST_ENSEMBLE_STAT_VAR3_LEVELS = Z0

FCST_ENSEMBLE_STAT_VAR4_NAME = APCP
FCST_ENSEMBLE_STAT_VAR4_LEVELS = Z0

# Surface Fluxes
FCST_ENSEMBLE_STAT_VAR5_NAME = LHTFL
FCST_ENSEMBLE_STAT_VAR5_LEVELS = Z0

FCST_ENSEMBLE_STAT_VAR6_NAME = SHTFL
FCST_ENSEMBLE_STAT_VAR6_LEVELS = Z0

# Clouds
FCST_ENSEMBLE_STAT_VAR7_NAME = TCDC
FCST_ENSEMBLE_STAT_VAR7_LEVELS = L0

# Radiation (Surface & Top of Atmosphere)
FCST_ENSEMBLE_STAT_VAR8_NAME = DSWRF
FCST_ENSEMBLE_STAT_VAR8_LEVELS = Z0, L0

FCST_ENSEMBLE_STAT_VAR9_NAME = DLWRF
FCST_ENSEMBLE_STAT_VAR9_LEVELS = Z0

FCST_ENSEMBLE_STAT_VAR10_NAME = USWRF
FCST_ENSEMBLE_STAT_VAR10_LEVELS = Z0, L0

FCST_ENSEMBLE_STAT_VAR11_NAME = ULWRF
FCST_ENSEMBLE_STAT_VAR11_LEVELS = Z0, L0

[dir]
FCST_ENSEMBLE_STAT_INPUT_DIR = {ENV[FCST_SFS]}
ENSEMBLE_STAT_OUTPUT_DIR = {ENV[ENS_DIR]}

[filename_templates]
FCST_ENSEMBLE_STAT_INPUT_TEMPLATE = mem*/acc.monthly.{init?fmt=%Y%m%d%H}.{valid?fmt=%Y%m}.grib.t00z.grb2
ENSEMBLE_STAT_OUTPUT_TEMPLATE = acc.monthly.{init?fmt=%Y%m%d%H}.{valid?fmt=%Y%m}.ens
