[config]
PROCESS_LIST = EnsembleStat

LOOP_BY = INIT
INIT_TIME_FMT = %Y%m%d%H
INIT_BEG = {ENV[INITDATE]}
INIT_END = {ENV[INITDATE]}

# Forecast leads: 0m corresponds to the first target month (e.g. 202609)
LEAD_SEQ = 0m, 1m, 2m, 3m, 4m, 5m, 6m, 7m, 8m, 9m, 10m, 11m

ENSEMBLE_STAT_N_ENS = 31
ENSEMBLE_STAT_ENS_THRESH = 1.0

ENSEMBLE_STAT_OUTPUT_FLAG_ECNT = NONE
ENSEMBLE_STAT_OUTPUT_FLAG_RPS = NONE

# ------------------------------------------------------------------------------
# Field Definitions (Matching wgrib2 records)
# ------------------------------------------------------------------------------
# Upper-Air Pressure Levels (P200, P500, P700, P850)
FCST_ENSEMBLE_STAT_VAR1_NAME = HGT
FCST_ENSEMBLE_STAT_VAR1_LEVELS = P200, P500, P700, P850

FCST_ENSEMBLE_STAT_VAR2_NAME = TMP
FCST_ENSEMBLE_STAT_VAR2_LEVELS = P200, P850

FCST_ENSEMBLE_STAT_VAR3_NAME = UGRD
FCST_ENSEMBLE_STAT_VAR3_LEVELS = P200, P850

FCST_ENSEMBLE_STAT_VAR4_NAME = VGRD
FCST_ENSEMBLE_STAT_VAR4_LEVELS = P200, P850

# Mean Sea Level & Surface Fields
FCST_ENSEMBLE_STAT_VAR5_NAME = PRMSL
FCST_ENSEMBLE_STAT_VAR5_LEVELS = L0

FCST_ENSEMBLE_STAT_VAR6_NAME = TMP
FCST_ENSEMBLE_STAT_VAR6_LEVELS = Z0, Z2

# Near-Surface 2m and 10m Fields
FCST_ENSEMBLE_STAT_VAR7_NAME = SPFH
FCST_ENSEMBLE_STAT_VAR7_LEVELS = Z2

FCST_ENSEMBLE_STAT_VAR8_NAME = DPT
FCST_ENSEMBLE_STAT_VAR8_LEVELS = Z2

FCST_ENSEMBLE_STAT_VAR9_NAME = RH
FCST_ENSEMBLE_STAT_VAR9_LEVELS = Z2

FCST_ENSEMBLE_STAT_VAR10_NAME = UGRD
FCST_ENSEMBLE_STAT_VAR10_LEVELS = Z10

FCST_ENSEMBLE_STAT_VAR11_NAME = VGRD
FCST_ENSEMBLE_STAT_VAR11_LEVELS = Z10

# Soil Moisture & Temperature (Depths below ground in meters)
FCST_ENSEMBLE_STAT_VAR12_NAME = TSOIL
FCST_ENSEMBLE_STAT_VAR12_LEVELS = D0-0.1, D0.1-0.4, D0.4-1, D1-2

FCST_ENSEMBLE_STAT_VAR13_NAME = SOILW
FCST_ENSEMBLE_STAT_VAR13_LEVELS = D0-0.1, D0.1-0.4, D0.4-1, D1-2

FCST_ENSEMBLE_STAT_VAR14_NAME = WEASD
FCST_ENSEMBLE_STAT_VAR14_LEVELS = Z0

[dir]
FCST_ENSEMBLE_STAT_INPUT_DIR = {ENV[FCST_SFS]}
ENSEMBLE_STAT_OUTPUT_DIR = {ENV[ENS_DIR]}

[filename_templates]
FCST_ENSEMBLE_STAT_INPUT_TEMPLATE = mem*/inst.monthly.{init?fmt=%Y%m%d%H}.{valid?fmt=%Y%m}.grib.t00z.grb2
ENSEMBLE_STAT_OUTPUT_TEMPLATE = inst.monthly.{init?fmt=%Y%m%d%H}.{valid?fmt=%Y%m}.ens
