#!/bin/bash
set -x

# ###################################
# SET SHELL PROCESSING VARIABLES
# ###################################
export PS4='$SECONDS + '
date

###########################################################
# obtain unique LSF id (jobid) and make temp directories
###########################################################
export DATA=${DATA:-${DATAROOT:?}/${jobid:?}}
mkdir -p $DATA
cd $DATA

####################################
### Define NET/RUN variables
######################################
export NET=${NET:-evs}
export STEP=${STEP:-prep}
export COMPONENT=${COMPONENT:-seasonal}
export RUN=${RUN:-atmos}
export machine=${machine:-WCOSS2}


################################################################
# Set data directives
# SENDCOM=YES--Copy files from TMPDIR to $COMOUT
# SENDMAIL=YES--Send missing data emails
# SENDDBN=YES--Issue DBNet client calls
# SENDECF=YES--Flag events on ecflow
################################################################
export SENDCOM=${SENDCOM:-YES}
export SENDMAIL=${SENDMAIL:-NO}
export SENDDBN=${SENDDBN:-NO}       # need to set to NO for testing
export SENDECF=${SENDECF:-NO}

################################################################
# Set EVS directories
################################################################
export HOMEevs=${HOMEevs:-${PACKAGEROOT}/${NET}.${evs_ver}}
export EXECevs=${EXECevs:-$HOMEevs/exec}
export PARMevs=${PARMevs:-$HOMEevs/parm}
export USHevs=${USHevs:-$HOMEevs/ush}
export FIXevs=${FIXevs:-$HOMEevs/fix}


###
export vhr=${vhr:-00}
export cycle=${cycle:-t${vhr}z}

setpdy.sh
. ./PDY

# HARDWIRE FOR TESTING UNTIL FINALIZED
PDY=202610112
PDY=202510112

# Derive the previous month from PDY
# Setting it to day "01" of the current $PDY ensures safe backtracking
PREVIOUS_YYYYMM=$(date -d "${PDY:0:6}01 -1 month" +"%Y%m")
# Extract year (YYYY) and 2-digit month (MM)
export INITYEAR="${PREVIOUS_YYYYMM:0:4}"
export INITMONTH="${PREVIOUS_YYYYMM:4:2}"


#######################################################################
# Execute the script
#######################################################################
echo "PREP_TYPE: ${PREP_TYPE}"
"$HOMEevs/scripts/$STEP/$COMPONENT/exevs_${STEP}_${COMPONENT}_${PREP_TYPE}.sh"

export err=$?; err_chk
if [ "$KEEPDATA" != "YES" ] ; then
  cd $DATAROOT
  rm -rf $DATA
fi


