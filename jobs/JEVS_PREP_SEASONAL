#!/bin/bash
# EVS seasonal component - prep step job wrapper
# This script is intended to be called by a driver script that sets:
#   STEP=prep, COMPONENT=seasonal, RUN=det|ens

set -euo pipefail
set -x

###############################################################################
# 1) Basic guards
###############################################################################
: "${HOMEevs:?HOMEevs must be set (repo root path in ops/dev env)}"
: "${RUN:?RUN must be set to det or ens}"
: "${STEP:=prep}"
: "${COMPONENT:=seasonal}"

if [[ "${RUN}" != "det" && "${RUN}" != "ens" ]]; then
  echo "ERROR: RUN must be 'det' or 'ens'. Got: ${RUN}"
  exit 2
fi

###############################################################################
# 2) Paths and defaults
###############################################################################
# Expected to come from driver script, but provide safe defaults
export NET="${NET:-evs}"
export envir="${envir:-prod}"
export DATAROOT="${DATAROOT:-/tmp/${USER}/evs/${NET}/${COMPONENT}/${STEP}}"
export COMROOT="${COMROOT:-/tmp/${USER}/evs/com}"
export COMIN="${COMIN:-${COMROOT}/in/${NET}}"
export COMOUT="${COMOUT:-${COMROOT}/out/${NET}/${STEP}/${COMPONENT}/${RUN}}"

export EVS_CONFIG_DIR="${EVS_CONFIG_DIR:-${HOMEevs}/parm/evs_config/${COMPONENT}}"
export EVS_COMMON_CONF="${EVS_COMMON_CONF:-${EVS_CONFIG_DIR}/seasonal_common.conf}"
export EVS_RUN_CONF="${EVS_RUN_CONF:-${EVS_CONFIG_DIR}/seasonal_${RUN}.conf}"

# Optional helper script paths
export USHseasonal="${USHseasonal:-${HOMEevs}/ush/seasonal}"
export SCRIPTseasonal="${SCRIPTseasonal:-${HOMEevs}/scripts/seasonal/prep}"

mkdir -p "${DATAROOT}" "${COMOUT}"
cd "${DATAROOT}"

###############################################################################
# 3) Load configuration
###############################################################################
if [[ ! -f "${EVS_COMMON_CONF}" ]]; then
  echo "ERROR: Missing common config: ${EVS_COMMON_CONF}"
  exit 3
fi

if [[ ! -f "${EVS_RUN_CONF}" ]]; then
  echo "ERROR: Missing run config: ${EVS_RUN_CONF}"
  exit 3
fi

# shellcheck disable=SC1090
source "${EVS_COMMON_CONF}"
# shellcheck disable=SC1090
source "${EVS_RUN_CONF}"

###############################################################################
# 4) Compute cycle/time context
###############################################################################
# Common EVS pattern: PDY + cyc. Allow override from scheduler/driver.
export PDY="${PDY:-$(date -u +%Y%m%d)}"
export cyc="${cyc:-00}"
export cycle="${PDY}${cyc}"

# Work/output roots for this cycle
export WORK_BASE="${WORK_BASE:-${DATAROOT}/${COMPONENT}/${RUN}/${cycle}}"
export PREP_OUT_BASE="${PREP_OUT_BASE:-${COMOUT}/${cycle}}"
mkdir -p "${WORK_BASE}" "${PREP_OUT_BASE}"

echo "=== EVS seasonal prep ==="
echo "NET=${NET} envir=${envir} STEP=${STEP} COMPONENT=${COMPONENT} RUN=${RUN}"
echo "cycle=${cycle}"
echo "COMIN=${COMIN}"
echo "COMOUT=${COMOUT}"
echo "WORK_BASE=${WORK_BASE}"
echo "PREP_OUT_BASE=${PREP_OUT_BASE}"

###############################################################################
# 5) Run seasonal prep workflow
###############################################################################
# Prefer a run-specific prep wrapper if present.
RUN_PREP_SCRIPT="${SCRIPTseasonal}/prep_seasonal_${RUN}.sh"

if [[ -x "${RUN_PREP_SCRIPT}" ]]; then
  "${RUN_PREP_SCRIPT}"
else
  echo "INFO: Run-specific prep script not found/executable: ${RUN_PREP_SCRIPT}"
  echo "INFO: Falling back to placeholder prep behavior."

  # Placeholder behavior: create an inventory file showing resolved config
  cat > "${PREP_OUT_BASE}/seasonal_prep_inventory.${cycle}.txt" <<EOF
NET=${NET}
envir=${envir}
STEP=${STEP}
COMPONENT=${COMPONENT}
RUN=${RUN}
cycle=${cycle}
SEASONAL_MODELS=${SEASONAL_MODELS:-}
SEASONAL_OBS=${SEASONAL_OBS:-}
SEASONAL_LEADS=${SEASONAL_LEADS:-}
SEASONAL_DOMAINS=${SEASONAL_DOMAINS:-}
EOF
fi

###############################################################################
# 6) Basic completion marker
###############################################################################
touch "${PREP_OUT_BASE}/seasonal_prep.${RUN}.${cycle}.done"
echo "SUCCESS: seasonal prep complete for RUN=${RUN}, cycle=${cycle}"
